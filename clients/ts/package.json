{
  "name": "sipline",
  "version": "0.2.0",
  "description": "Client and Express/Fastify middleware for the sipline rate limiter",
  "license": "MIT",
  "keywords": ["rate-limit", "rate-limiter", "token-bucket", "express", "fastify", "middleware"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realChriss/sipline.git",
    "directory": "clients/ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && bun test",
    "prepublishOnly": "bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "typescript": "^7.0.2"
  }
}
